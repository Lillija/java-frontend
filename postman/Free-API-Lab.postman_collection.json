    {
      "name": "3 · Sava REST API — laravel-api (zirodev23)",
      "description": "Šī projekta Laravel REST API. `POST /login` atgriež Sanctum token, kas automātiski saglabājas mainīgajā `{{token}}` — pārējie pieprasījumi to izmanto.",
      "item": [
        {
          "name": "GET /api/posts — resursu saraksts (bez autentifikācijas)",
          "description": "REST: `GET` + resurss `/posts`. Atbild ar masīvu (200).",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type: application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"posts ir masīvs ar objektiem\", function () {",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    pm.expect(body[0]).to.have.property(\"title\");",
                  "    pm.expect(body[0]).to.have.property(\"body\");",
                  "});"
