      "key": "postId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 · Free REST API — Open-Meteo (laikapstākļi)",
      "description": "Bezmaksas REST API bez atslēgas. Katrs pieprasījums atšķiras ar query parametriem — tāpat kā Postman testēšanā uzdevumā Nr.1.",
      "item": [
        {
          "name": "Geocode: Rīga (name, count, language, format)",
          "description": "Pirmā pārbaude — noklusētie parametri ar pilsētas nosaukumu `name`.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type: application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"vismaz viens rezultāts\", function () {",
                  "    pm.expect(body.results).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "pm.test(\"rezultātam ir latitude/longitude\", function () {",
                  "    pm.expect(body.results[0]).to.have.property(\"latitude\");",
                  "    pm.expect(body.results[0]).to.have.property(\"longitude\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://geocoding-api.open-meteo.com/v1/search?name=Rīga&count=1&language=en&format=json",
              "protocol": "https",
              "host": [
                "geocoding-api",
                "open-meteo",
                "com"
              ],
              "path": [
                "v1",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "Rīga"
                },
                {
                  "key": "count",
                  "value": "1"
                },
                {
                  "key": "language",
                  "value": "en"
                },
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            }
          },
          "response": [
            {
              "name": "200 · Rīga",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Date",
                  "value": "Wed, 07 Oct 2026 11:15:00 GMT"
                }
              ],
              "cookie": [],
              "body": "{\"results\":[{\"id\":456172,\"name\":\"Riga\",\"latitude\":56.946,\"longitude\":24.10589,\"elevation\":6.0,\"feature_code\":\"PPLC\",\"country_code\":\"LV\",\"admin1_id\":456173,\"admin2_id\":11352868,\"timezone\":\"Europe/Riga\",\"population\":742572,\"country_id\":458258,\"country\":\"Latvia\",\"admin1\":\"Riga\",\"admin2\":\"Rīga\"}],\"generationtime_ms\":0.5443096}"
            }
