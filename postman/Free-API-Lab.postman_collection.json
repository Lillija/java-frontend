    {
      "name": "2 · Free REST API — icanhazdadjoke (joki)",
      "description": "Bezmaksas REST API ar query parametriem `term`, `limit`, `page`. Prasa headeri `Accept: application/json` (citādāk atnāk HTML).",
      "item": [
        {
          "name": "Search: term=food, limit=1",
          "description": "Meklēšana ar query parametriem `term` un `limit`.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type: application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"limit=1 → tieši viens joks\", function () {",
                  "    pm.expect(body.results).to.have.lengthOf(1);",
                  "    pm.expect(body.results[0].joke).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"pagination info klāt\", function () {",
                  "    pm.expect(body.total_jokes).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
